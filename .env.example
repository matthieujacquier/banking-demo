# Copy to .env.local (never committed) and set the same values in Vercel.

# DY site id — client-safe, injected into the DY script URLs.
NEXT_PUBLIC_DY_SITE_ID=8782014

# DY Experience API key — server-side only (used by /api/dy/* routes).
# DY_SERVER_API_KEY takes precedence over DY_API_KEY.
DY_SERVER_API_KEY=
DY_API_KEY=

# Public origin used for absolute URLs in the product feed and as the fallback
# page location on server-side DY calls. Defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://banking-demo-five.vercel.app

# "api" (default) renders our own Shopping Muse panel; "template" leaves the
# dy-chat-cta launcher to DY's Shopping Muse Chat template.
NEXT_PUBLIC_MUSE_MODE=api
